pipeline {
    agent any

    environment {
        IMAGE_NAME     = 'react-vite-showcase'
        CONTAINER_NAME = 'frontend-app'
        HOST_PORT      = '8080' 
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Construir Imagen Docker') {
            steps {
                script {
                    echo "Construyendo la imagen: ${IMAGE_NAME}"
                    sh "docker build -t ${IMAGE_NAME}:latest ."
                }
            }
        }

        stage('Desplegar Contenedor') {
            steps {
                script {
                    echo "Limpiando contenedores anteriores..."
                    sh "docker stop ${CONTAINER_NAME} || true"
                    sh "docker rm ${CONTAINER_NAME} || true"
                    
                    echo "Levantando el nuevo contenedor en el puerto ${HOST_PORT}..."
                    sh "docker run -d --name ${CONTAINER_NAME} -p ${HOST_PORT}:80 ${IMAGE_NAME}:latest"
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline finalizado. Limpiando workspace...'
            cleanWs()
        }
        success {
            echo "¡Despliegue exitoso! La aplicación está corriendo en el puerto ${HOST_PORT}"
        }
        failure {
            echo "El pipeline falló. Revisa los logs de Jenkins para más detalles."
        }
    }
}